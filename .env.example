# Copy this file to .env and fill in real values before running
# `docker compose -f docker-compose.yml up --build` on a production host.
# .env is gitignored - never commit your real values.

# Credentials for the self-hosted S3-compatible artifact store (RustFS).
# These are used both as RustFS's own admin credentials and as the
# access/secret key the controlplane, gateway, and runtime containers
# use to reach it. Generate random values - do not reuse these examples.
S3_ARTIFACT_ACCESS_KEY=changeme-access-key
S3_ARTIFACT_SECRET_KEY=changeme-secret-key

# Optional overrides (safe defaults are used if left unset):
# S3_ARTIFACT_BUCKET=funchole-artifacts
# S3_ARTIFACT_REGION=us-east-1

# Postgres password, used by the db service itself and every app service
# that talks to it. Generate with: openssl rand -hex 32
DB_PASSWORD=changeme-db-password

# Password for the separate tenant-db Postgres server's maintenance role
# (tenant_admin) - controlplane uses this solely to run CREATE ROLE/CREATE
# DATABASE when auto-provisioning each new cloud user's default database.
# Not used for tenant traffic itself. Generate with: openssl rand -hex 32
TENANT_DB_ADMIN_PASSWORD=changeme-tenant-db-admin-password

# JWT signing secret. Must be base64. Generate with: openssl rand -base64 48
JWT_SECRET=changeme-base64-jwt-secret

# Initial admin account. The seeded admin's username is always "admin"
# (BOOTSTRAP_USERNAME isn't wired to rename it yet - leave it as "admin").
# On first boot, if BOOTSTRAP_PASSWORD differs from the repo's known
# default ("admin12345"), the seeded admin's password is rotated to this
# value automatically (see AdminBootstrapRunner) - log in with this
# password afterward, not the default. Generate one with:
# openssl rand -base64 24
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme-admin-password

# Optional: real trusted certificates via Let's Encrypt instead of the
# self-signed default. Only set this once a real domain's DNS A record
# already points at this host - Let's Encrypt validates ownership by
# connecting to port 80 here (already published in docker-compose.yml).
# CERTIFICATE_PROVIDER=LETS_ENCRYPT

# Optional: "Sign in with Google" on the admin login page
# (http://localhost:3000/login in dev). Unset by default - the Google
# button just doesn't appear, and username/password login keeps working
# as-is. This does NOT create new accounts: a verified Google sign-in from
# an address in ADMIN_ALLOWED_GOOGLE_EMAILS logs in as the one bootstrap
# admin account above - any other Google account is rejected. See
# docs/development.md for how to create a Client ID in Google Cloud
# Console (no client secret needed for this flow).
# GOOGLE_OAUTH_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# ADMIN_ALLOWED_GOOGLE_EMAILS=you@gmail.com

# Optional: cloud product only - leave unset for a normal self-hosted
# install. Setting CLOUD_MODE_ENABLED=true turns any verified Google
# sign-in into real self-registration (ADMIN_ALLOWED_GOOGLE_EMAILS above is
# ignored), assigns each new user the seeded "free" package (1 default
# Gateway, 0 attachable Domains, 20 Flows, 100 Functions), and enforces
# those limits on every Function/Flow/Gateway/Domain creation. Only the
# bootstrap admin account can create AppDomains - every other user's
# Gateway lands on a randomly chosen one of the admin's verified domains
# automatically, so create and verify at least one domain (as the admin)
# before anyone self-registers. See docs/development.md before enabling this.
# CLOUD_MODE_ENABLED=true

# Optional: cloud product only - reverse-proxies the admin web app and/or
# the controlplane API to a fixed public hostname, straight through the
# Gateway's existing port 443 (no separate reverse proxy like Caddy/nginx
# needed). Either, both, or neither may be set. Each hostname needs its own
# real Gateway/AppDomain row provisioned (zero Flows attached) so it gets a
# TLS certificate through the normal domain-verification flow - see
# docs/development.md before enabling this.
# ADMIN_WEB_PROXY_HOST=app.funchole.dev
# CONTROLPLANE_API_PROXY_HOST=api-controlplane.funchole.dev

# Required alongside CONTROLPLANE_API_PROXY_HOST above: the public URL the
# browser calls the controlplane API at (baked into the web app at build
# time - see docs/environment-variables.md). Leave unset in a plain
# self-hosted install.
# PUBLIC_CONTROLPLANE_URL=https://api-controlplane.funchole.dev

# Required alongside ADMIN_WEB_PROXY_HOST above: the web app's own public
# origin, so the browser's cross-origin calls to the API above pass CORS
# preflight. Must match exactly (scheme + host, no trailing slash) or every
# browser request fails with a CORS error, not a clear auth error.
# CORS_ALLOWED_ORIGINS=https://app.funchole.dev
