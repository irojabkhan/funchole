# Copy this file to .env and fill in real values before running
# `docker compose -f docker-compose.yml up --build` on a production host.
# .env is gitignored - never commit your real values.

# Credentials for the self-hosted S3-compatible artifact store (RustFS).
# These are used both as RustFS's own admin credentials and as the
# access/secret key the controlplane, gateway, and runtime containers
# use to reach it. Generate random values - do not reuse these examples.
S3_ARTIFACT_ACCESS_KEY=changeme-access-key
S3_ARTIFACT_SECRET_KEY=changeme-secret-key

# Optional overrides (safe defaults are used if left unset):
# S3_ARTIFACT_BUCKET=funchole-artifacts
# S3_ARTIFACT_REGION=us-east-1

# NOTE: database credentials, the JWT signing secret, and the initial
# admin account are currently provisioned separately via
# docker/openbao-init/secrets/**/app.json and a seeded Flyway migration.
# Those ship with known, publicly-visible default values today and must
# be rotated by hand before exposing this instance to the public internet
# - see PRODUCTION_DEPLOYMENT_MISSING.md section 3 for details. This file
# does not yet cover that gap.
