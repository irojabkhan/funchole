# Copy this file to .env and fill in real values before running
# `docker compose -f docker-compose.yml up --build` on a production host.
# .env is gitignored - never commit your real values.

# Credentials for the self-hosted S3-compatible artifact store (RustFS).
# These are used both as RustFS's own admin credentials and as the
# access/secret key the controlplane, gateway, and runtime containers
# use to reach it. Generate random values - do not reuse these examples.
S3_ARTIFACT_ACCESS_KEY=changeme-access-key
S3_ARTIFACT_SECRET_KEY=changeme-secret-key

# Optional overrides (safe defaults are used if left unset):
# S3_ARTIFACT_BUCKET=funchole-artifacts
# S3_ARTIFACT_REGION=us-east-1

# Postgres password, used by the db service itself and every app service
# that talks to it. Generate with: openssl rand -hex 32
DB_PASSWORD=changeme-db-password

# JWT signing secret. Must be base64. Generate with: openssl rand -base64 48
JWT_SECRET=changeme-base64-jwt-secret

# Initial admin account. The seeded admin's username is always "admin"
# (BOOTSTRAP_USERNAME isn't wired to rename it yet - leave it as "admin").
# On first boot, if BOOTSTRAP_PASSWORD differs from the repo's known
# default ("admin12345"), the seeded admin's password is rotated to this
# value automatically (see AdminBootstrapRunner) - log in with this
# password afterward, not the default. Generate one with:
# openssl rand -base64 24
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme-admin-password

# Optional: real trusted certificates via Let's Encrypt instead of the
# self-signed default. Only set this once a real domain's DNS A record
# already points at this host - Let's Encrypt validates ownership by
# connecting to port 80 here (already published in docker-compose.yml).
# CERTIFICATE_PROVIDER=LETS_ENCRYPT
